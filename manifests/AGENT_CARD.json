      "transport": "streamable-http",
      "endpoints": {
        "streamable_http": "http://localhost:8000/mcp",
        "stdio": "icuvitals-mcp"
      }
    },
    "rest": {
      "versions": ["v1", "v2"],
      "base_url": "http://localhost:8000"
    }
  },
  "skills": [
    {
      "id": "icu-forecast",
      "name": "ICU Vital Forecast",
      "description": "Trend extrapolation + SafetyShell-bounded forecast + DDS assessment.",
      "tags": ["icu", "vitals", "forecasting", "dds"],
      "examples": ["ingest_vitals", "get_forecast", "get_deterioration_index"],
      "output_modes": ["application/vnd.mcp.tool-result+json", "application/json"]
