    "dataFreshnessField": "_meta.data_freshness_seconds",
    "phiInMetrics": false,
    "coreIsolation": true,
    "auth": {
      "scheme": "CIMD-JWT",
      "principalClaim": "sub",
      "principalField": "requested_by",
      "requiredFor": ["ingest_vitals", "get_forecast", "get_deterioration_index", "discover_episode"]
    }
  },
  "securitySchemes": {
    "CIMD-JWT": {
      "type": "http",
      "scheme": "bearer",
